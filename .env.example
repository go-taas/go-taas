# Example environment file for the local docker-compose verification
# stack. Copy to `.env` (which is git-ignored) and fill in the values:
#
#   cp .env.example .env
#
# `make compose-up` reads it via `docker compose --env-file .env`. Every
# value is consumed either by the `juicefs` service or forwarded to the
# control plane / controller through `CONFIG_*` overrides in
# deploy/compose/docker-compose.yaml.

# ---- Internal Harbor registry (image import) --------------------------
# The image-import flow pulls an engine image from a source registry and
# pushes it into <HARBOR_URL>/<HARBOR_PROJECT>. HARBOR_URL is the
# registry host WITHOUT scheme (e.g. hub.example.com).
HARBOR_URL=hub.example.com
HARBOR_USERNAME=admin
HARBOR_PASSWORD=changeme

# ---- JuiceFS model-weights filesystem ---------------------------------
# Shared by the compose control plane (mounted at /data/weights) and the
# inference pods (mounted through the cluster StorageClass). Backed by
# the cluster MinIO bucket and metadata in the cluster Redis DB 1.
#
# `make compose-up` creates the cluster resources automatically via
# deploy/compose/scripts/cluster-up.sh (MinIO bucket, JuiceFS filesystem,
# namespace, storageclass, secret, PVC, redis NodePort, node labels);
# `make compose-down` removes them via cluster-down.sh. The cluster Redis
# is published on the node IP at :30379 (the cluster Redis has no
# password, so the URL carries none).
JUICE_FS_NAME=jfs-taas-models
JUICE_FS_META_URL=redis://<node-ip>:30379/1
JUICE_FS_STORAGE=s3
# MinIO is exposed on the node IP (hostNetwork); use http://<node-ip>:9000/<bucket>.
JUICE_FS_BUCKET=http://<node-ip>:9000/taas
JUICE_FS_ACCESS_KEY=minio-access-key
JUICE_FS_SECRET_KEY=minio-secret-key

# ---- Kubernetes weights storage ---------------------------------------
# The JuiceFS-backed StorageClass the controller provisions the shared
# model-weights PVC from. Must match the StorageClass created in the
# cluster (pathPattern "/" so the whole filesystem is mounted).
WEIGHTS_STORAGE_CLASS=juicefs-taas-models

# ---- Webhook secret-at-rest encryption key (feature #23) --------------
# The AES-256-GCM master key used to encrypt webhook signing secrets at
# rest (AD3). Production must set a strong random key; empty falls back
# to a dev-only key derived from the MQ namespace.
WEBHOOK_SECRET_ENCRYPTION_KEY=changeme-32-byte-key-0000000000

# ---- Provider secret-at-rest encryption key (feature #48) -------------
# The AES-256-GCM master key used to encrypt external-provider API keys
# at rest (AD3/AD12). Production must set a strong random key; empty
# falls back to a dev-only key derived from the MQ namespace.
PROVIDER_SECRET_ENCRYPTION_KEY=

# ---- Model observability max range (feature #24) ----------------------
# The maximum range accepted by the observability RPCs (AD7). Default
# 7948800 (92 days); a longer range returns 10404.
OBSERVABILITY_MAX_RANGE_SECONDS=7948800

# ---- Usage & cost forecasting (feature #36) ---------------------------
# The forecast bounds (AD3, AD4). Empty falls back to the defaults
# (30 / 90 / 92). Forwarded to the control plane as
# CONFIG_BILLING_FORECAST_* in deploy/compose/docker-compose.yaml.
BILLING_FORECAST_HORIZON_DEFAULT_DAYS=30
BILLING_FORECAST_HORIZON_MAX_DAYS=90
BILLING_FORECAST_RANGE_MAX_DAYS=92

# Optional overrides ----------------------------------------------------
# CONTROLLER_NAMESPACE=taas
# KUBECONFIG=/path/to/kubeconfig
# JUICE_FS_HOST_MOUNT=/var/lib/go-taas/juicefs
