{
  "realm": "go-taas",
  "enabled": true,
  "displayName": "go-taas local IdP",
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "go-taas-console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "go-taas-console-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9091/api/v1/auth/sso/*"
      ],
      "webOrigins": [
        "http://localhost:9091"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}